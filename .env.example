# ArcVault Intake & Triage — optional configuration.
# Everything has a working default; the project runs with NO .env file at all.
# No secrets are required anywhere (emails are captured locally by Mailpit).

# Master switch for the email notification step (true/false)
EMAIL_NOTIFICATIONS_ENABLED=true

# Where the workflow delivers notifications (Mailpit's HTTP send API)
MAILPIT_API_URL=http://mailpit:8025

# Deterministic recipient per routing destination (demo/local addresses only)
ENGINEERING_EMAIL=engineering@arcvault.local
PRODUCT_EMAIL=product@arcvault.local
BILLING_EMAIL=billing@arcvault.local
SECURITY_EMAIL=security@arcvault.local
HUMAN_REVIEW_EMAIL=human-review@arcvault.local
